# Database (Neon PostgreSQL)
# Pooled connection string for application runtime (routes through PgBouncer, hostname has -pooler)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/ayukara?sslmode=require"

# Direct connection string for migrations, sequelize-cli, and schema tasks (unpooled, no -pooler)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.neon.tech/ayukara?sslmode=require"

# LLM Provider Configuration (default: openai)
LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.9router.com/v1" # Optional: untuk gateway/router OpenAI-compatible seperti 9router
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY="your-openai-api-key"

# Web Search Provider Configuration (default: tavily | exa | brave)
SEARCH_PROVIDER="tavily"
SEARCH_API_KEY="your-search-api-key"

# Price Cache (Upstash Redis REST API)
UPSTASH_REDIS_REST_URL="https://sample.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

